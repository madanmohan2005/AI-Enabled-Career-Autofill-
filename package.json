{
  "name": "careerfill-extension",
  "version": "0.1.0",
  "description": "AI-powered career autofill Chrome extension",
  "scripts": {
    "build:popup": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "vite build && vite build --config vite.content.config.ts && node -e \"require('fs').copyFileSync('manifest.json', 'dist/manifest.json')\"",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.233",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  }
}
